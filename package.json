{
  "name": "hotelpro",
  "version": "1.0.0",
  "private": true,
  "description": "MERN hotel booking and management platform",
  "workspaces": ["client", "server"],
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "seed": "npm run seed --workspace server"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
